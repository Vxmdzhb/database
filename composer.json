{
    "name": "astrx/database",
    "description": "The PDO connection factory and the schema files installers apply.",
    "license": "LicenseRef-DoWhatever",
    "type": "library",
    "keywords": [
        "astrx",
        "no-javascript",
        "server-rendered"
    ],
    "homepage": "https://github.com/Vxmdzhb/database",
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*",
        "astrx/config": "self.version",
        "astrx/result": "self.version"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "AstrX\\Database\\": ""
        }
    },
    "extra": {
        "astrx": {
            "resources": "resources"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/result"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/support"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/config"
        }
    ]
}
